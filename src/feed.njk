---
permalink: /feed.xml
eleventyExcludeFromCollections: true
metadata:
  language: id
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ metadata.language }}">
  <title>{{ site.title }}</title>
  <subtitle>{{ site.description }}</subtitle>
  <link href="{{ site.url }}/feed.xml" rel="self"/>
  <link href="{{ site.url }}/"/>
  <updated>{{ collections.posts[0].date | dateToRfc3339 }}</updated>
  <id>{{ site.url }}/</id>
  <author>
    <name>{{ site.author.name }}</name>
    <email>{{ site.author.email }}</email>
  </author>
  {%- for post in collections.posts | reverse %}
  <entry>
    <title>{{ post.data.title }}</title>
    <link href="{{ site.url }}{{ post.url }}"/>
    <updated>{{ post.date | dateToRfc3339 }}</updated>
    <id>{{ site.url }}{{ post.url }}</id>
    {%- if post.data.excerpt %}
    <summary>{{ post.data.excerpt }}</summary>
    {%- endif %}
    {%- if post.data.location %}
    <category term="{{ post.data.location }}" />
    {%- endif %}
    <content type="html"><![CDATA[{{ post.templateContent }}]]></content>
  </entry>
  {%- endfor %}
</feed>